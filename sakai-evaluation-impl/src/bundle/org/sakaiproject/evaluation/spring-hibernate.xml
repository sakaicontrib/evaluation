<beans xmlns="http://www.springframework.org/schema/beans"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans.xsd">
    
    <!-- define the list of HBM mapping files -->
    <bean id="evaluation.hbmMappingList" class="java.util.ArrayList">
        <constructor-arg>
            <list>
                <value>org/sakaiproject/evaluation/dao/hbm/EvalAdhocGroup.hbm.xml</value>
                <value>org/sakaiproject/evaluation/dao/hbm/EvalAdhocUser.hbm.xml</value>
				<value>org/sakaiproject/evaluation/dao/hbm/EvalAdmin.hbm.xml</value>
                <value>org/sakaiproject/evaluation/dao/hbm/EvalAnswer.hbm.xml</value>
                <value>org/sakaiproject/evaluation/dao/hbm/EvalAssignGroup.hbm.xml</value>
                <value>org/sakaiproject/evaluation/dao/hbm/EvalAssignHierarchy.hbm.xml</value>
                <value>org/sakaiproject/evaluation/dao/hbm/EvalAssignUser.hbm.xml</value>
                <value>org/sakaiproject/evaluation/dao/hbm/EvalConfig.hbm.xml</value>
                <value>org/sakaiproject/evaluation/dao/hbm/EvalEmailProcessingData.hbm.xml</value>
                <value>org/sakaiproject/evaluation/dao/hbm/EvalEmailTemplate.hbm.xml</value>
                <value>org/sakaiproject/evaluation/dao/hbm/EvalEvaluation.hbm.xml</value>
                <value>org/sakaiproject/evaluation/dao/hbm/EvalGroupNodes.hbm.xml</value>
                <value>org/sakaiproject/evaluation/dao/hbm/EvalHierarchyRule.hbm.xml</value>
                <value>org/sakaiproject/evaluation/dao/hbm/EvalItem.hbm.xml</value>
                <value>org/sakaiproject/evaluation/dao/hbm/EvalItemGroup.hbm.xml</value>
                <value>org/sakaiproject/evaluation/dao/hbm/EvalLock.hbm.xml</value>
                <value>org/sakaiproject/evaluation/dao/hbm/EvalResponse.hbm.xml</value>
                <value>org/sakaiproject/evaluation/dao/hbm/EvalScale.hbm.xml</value>
                <value>org/sakaiproject/evaluation/dao/hbm/EvalTags.hbm.xml</value>
                <value>org/sakaiproject/evaluation/dao/hbm/EvalTagsMeta.hbm.xml</value>
                <value>org/sakaiproject/evaluation/dao/hbm/EvalTemplate.hbm.xml</value>
                <value>org/sakaiproject/evaluation/dao/hbm/EvalTemplateItem.hbm.xml</value>
                <value>org/sakaiproject/evaluation/dao/hbm/EvalTranslation.hbm.xml</value>
            </list>
        </constructor-arg>
    </bean>

    <!-- Hibernate-backed evaluation DAO ports -->
    <bean id="org.sakaiproject.evaluation.dao.EvaluationDaoBase"
        class="org.sakaiproject.evaluation.dao.EvaluationDaoBaseImpl">
        <property name="sessionFactory"
            ref="org.sakaiproject.springframework.orm.hibernate.GlobalSessionFactory" />
    </bean>
    <bean id="org.sakaiproject.evaluation.dao.EvaluationSettingsDao"
        class="org.sakaiproject.evaluation.dao.EvaluationSettingsDaoImpl">
        <property name="sessionFactory"
            ref="org.sakaiproject.springframework.orm.hibernate.GlobalSessionFactory" />
    </bean>
    <bean id="org.sakaiproject.evaluation.dao.EvaluationEmailTemplateDao"
        class="org.sakaiproject.evaluation.dao.EvaluationEmailTemplateDaoImpl">
        <property name="sessionFactory"
            ref="org.sakaiproject.springframework.orm.hibernate.GlobalSessionFactory" />
    </bean>
    <bean id="org.sakaiproject.evaluation.dao.EvaluationAuthoringDao"
        class="org.sakaiproject.evaluation.dao.EvaluationAuthoringDaoImpl">
        <property name="sessionFactory"
            ref="org.sakaiproject.springframework.orm.hibernate.GlobalSessionFactory" />
    </bean>
    <bean id="org.sakaiproject.evaluation.dao.EvaluationGroupNodeDao"
        class="org.sakaiproject.evaluation.dao.EvaluationGroupNodeDaoImpl">
        <property name="sessionFactory"
            ref="org.sakaiproject.springframework.orm.hibernate.GlobalSessionFactory" />
    </bean>
    <bean id="org.sakaiproject.evaluation.dao.EvaluationAdminSupportDao"
        class="org.sakaiproject.evaluation.dao.EvaluationAdminSupportDaoImpl">
        <property name="sessionFactory"
            ref="org.sakaiproject.springframework.orm.hibernate.GlobalSessionFactory" />
    </bean>
    <bean id="org.sakaiproject.evaluation.dao.EvaluationResponseDao"
        class="org.sakaiproject.evaluation.dao.EvaluationResponseDaoImpl">
        <property name="sessionFactory"
            ref="org.sakaiproject.springframework.orm.hibernate.GlobalSessionFactory" />
    </bean>
    <bean id="org.sakaiproject.evaluation.dao.EvaluationAssignmentDao"
        class="org.sakaiproject.evaluation.dao.EvaluationAssignmentDaoImpl">
        <property name="sessionFactory"
            ref="org.sakaiproject.springframework.orm.hibernate.GlobalSessionFactory" />
        <property name="responseDao" ref="org.sakaiproject.evaluation.dao.EvaluationResponseDao" />
    </bean>
    <bean id="org.sakaiproject.evaluation.dao.EvaluationQueryDao"
        class="org.sakaiproject.evaluation.dao.EvaluationQueryDaoImpl">
        <property name="sessionFactory"
            ref="org.sakaiproject.springframework.orm.hibernate.GlobalSessionFactory" />
    </bean>
    <bean id="org.sakaiproject.evaluation.dao.EvaluationLockDao"
        class="org.sakaiproject.evaluation.dao.EvaluationLockDaoImpl">
        <property name="sessionFactory"
            ref="org.sakaiproject.springframework.orm.hibernate.GlobalSessionFactory" />
    </bean>
    <bean id="org.sakaiproject.evaluation.dao.EvaluationConsolidatedEmailDao"
        class="org.sakaiproject.evaluation.dao.EvaluationConsolidatedEmailDaoImpl">
        <property name="sessionFactory"
            ref="org.sakaiproject.springframework.orm.hibernate.GlobalSessionFactory" />
    </bean>

    <!-- create a data preloading bean which will be used by the data preloader -->
    <bean id="org.sakaiproject.evaluation.dao.PreloadData"
        class="org.sakaiproject.evaluation.dao.PreloadDataImpl">
        <property name="persistence" ref="org.sakaiproject.evaluation.dao.EvaluationDaoBase" />
        <property name="settingsDao" ref="org.sakaiproject.evaluation.dao.EvaluationSettingsDao" />
        <property name="emailTemplateDao" ref="org.sakaiproject.evaluation.dao.EvaluationEmailTemplateDao" />
        <property name="authoringDao" ref="org.sakaiproject.evaluation.dao.EvaluationAuthoringDao" />
        <property name="externalLogic"
            ref="org.sakaiproject.evaluation.logic.externals.EvalExternalLogic" />
    </bean>

    <!-- handles the adhoc user/group data saving/retrieval -->
    <bean id="org.sakaiproject.evaluation.dao.EvalAdhocSupport"
        class="org.sakaiproject.evaluation.dao.EvalAdhocSupportImpl">
        <property name="persistence" ref="org.sakaiproject.evaluation.dao.EvaluationDaoBase" />
        <property name="adminSupportDao" ref="org.sakaiproject.evaluation.dao.EvaluationAdminSupportDao" />
        <property name="settings" ref="org.sakaiproject.evaluation.logic.EvalSettings" />
    </bean>
	
	<bean id="org.sakaiproject.evaluation.dao.EvalAdminSupport"
		class="org.sakaiproject.evaluation.dao.EvalAdminSupportImpl">
		<property name="persistence" ref="org.sakaiproject.evaluation.dao.EvaluationDaoBase" />
		<property name="adminSupportDao" ref="org.sakaiproject.evaluation.dao.EvaluationAdminSupportDao" />
	</bean>

    <bean id="org.sakaiproject.evaluation.dao.EvalHierarchyRuleSupport"
        class="org.sakaiproject.evaluation.dao.EvalHierarchyRuleSupportImpl">
        <property name="persistence" ref="org.sakaiproject.evaluation.dao.EvaluationDaoBase" />
        <property name="adminSupportDao" ref="org.sakaiproject.evaluation.dao.EvaluationAdminSupportDao" />
    </bean>

    <!-- handles api based retrieval of application settings,
        this is in here because adhoc-dao-support needs it -->
    <bean id="org.sakaiproject.evaluation.logic.EvalSettings"
        class="org.sakaiproject.evaluation.logic.EvalSettingsImpl" init-method="init">
        <property name="settingsDao" ref="org.sakaiproject.evaluation.dao.EvaluationSettingsDao" />
        <property name="externalLogic"
            ref="org.sakaiproject.evaluation.logic.externals.EvalExternalLogic" />
    </bean>

    <!-- provides the invoker access to the dao -->
    <bean id="org.sakaiproject.evaluation.dao.EvalDaoInvoker"
        class="org.sakaiproject.evaluation.dao.EvalDaoInvokerImpl">
        <property name="transactionManager"
            ref="org.sakaiproject.springframework.orm.hibernate.GlobalTransactionManager" />
    </bean>

    <!-- beans for handling transactional access to all services -->

    <!-- a general transaction interceptor for the logic beans -->
    <bean id="org.sakaiproject.evaluation.interceptor.LogicTransactionProxy"
        class="org.springframework.transaction.interceptor.TransactionInterceptor">
      <property name="transactionManager" 
        ref="org.sakaiproject.springframework.orm.hibernate.GlobalTransactionManager" />
      <property name="transactionAttributes">
            <props>
                <prop key="get*">PROPAGATION_REQUIRED,readOnly</prop>
                <prop key="can*">PROPAGATION_REQUIRED,readOnly</prop>
                <prop key="check*">PROPAGATION_REQUIRED,readOnly</prop>
                <prop key="count*">PROPAGATION_REQUIRED,readOnly</prop>
                <prop key="*">PROPAGATION_REQUIRED</prop>
                <!-- <prop key="*">PROPAGATION_REQUIRED,+java.lang.RuntimeException</prop> -->
            </props>
        </property>
    </bean>

    <!--
        Legacy bean-name transaction proxying for the evaluation component.
        The custom proxy creator only forces Sakai's component classloader onto
        generated Spring proxies; transaction policy remains in the interceptor.
    -->
    <bean
        class="org.sakaiproject.evaluation.spring.SakaiComponentBeanNameAutoProxyCreator">
        <property name="interceptorNames">
            <list>
                <idref bean="org.sakaiproject.evaluation.interceptor.LogicTransactionProxy" />
            </list>
        </property>
        <property name="beanNames">
            <list>
                <value>org.sakaiproject.evaluation.dao.EvaluationDaoBase</value>
                <value>org.sakaiproject.evaluation.dao.EvaluationSettingsDao</value>
                <value>org.sakaiproject.evaluation.dao.EvaluationEmailTemplateDao</value>
                <value>org.sakaiproject.evaluation.dao.EvaluationAuthoringDao</value>
                <value>org.sakaiproject.evaluation.dao.EvaluationGroupNodeDao</value>
                <value>org.sakaiproject.evaluation.dao.EvaluationAdminSupportDao</value>
                <value>org.sakaiproject.evaluation.dao.EvaluationResponseDao</value>
                <value>org.sakaiproject.evaluation.dao.EvaluationAssignmentDao</value>
                <value>org.sakaiproject.evaluation.dao.EvaluationQueryDao</value>
                <value>org.sakaiproject.evaluation.dao.EvaluationLockDao</value>
                <value>org.sakaiproject.evaluation.dao.EvaluationConsolidatedEmailDao</value>
                <value>org.sakaiproject.evaluation.dao.EvalAdhocSupport</value>
                <value>org.sakaiproject.evaluation.dao.EvalAdminSupport</value>
                <value>org.sakaiproject.evaluation.dao.EvalHierarchyRuleSupport</value>
                <value>org.sakaiproject.evaluation.logic.Eval*</value>
                <value>org.sakaiproject.evaluation.beans.Eval*</value>
                <value>org.sakaiproject.evaluation.logic.import.Eval*</value>
            </list>
        </property>
    </bean>

</beans>
